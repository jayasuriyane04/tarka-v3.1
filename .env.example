# Copy to .env beside this file. Keep credentials out of chat and source control.
APP_ENV=development
DATABASE_URL=sqlite:///./tarka-v3-dev.db
SESSION_SECRET=development-only-replace-with-a-random-secret
COOKIE_SECURE=false
ALLOWED_ORIGINS=http://localhost:5175,http://127.0.0.1:5175,http://localhost:8003,http://127.0.0.1:8003

# A household's AI opt-in is separate from these operator spending controls.
# Both must permit inference. Do not enable spend without explicit authorization.
ENABLE_PAID_OPERATIONS=false
PAID_BUDGET_USD=0
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
NEBIUS_MODEL=nvidia/Nemotron-3_5-Lightning
NEBIUS_INPUT_USD_PER_MILLION=0.06
NEBIUS_OUTPUT_USD_PER_MILLION=0.24
MODEL_MAX_TOKENS=512

# Docker Compose database. Replace both secrets for shared deployment.
# A long randomly generated hexadecimal database password avoids URL encoding issues.
POSTGRES_USER=tarka_v3
POSTGRES_PASSWORD=local-development-replace-me
POSTGRES_DB=tarka_v3
